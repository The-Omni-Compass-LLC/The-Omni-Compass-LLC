"""Stand-in curl for tests/test_cruisekube.py: a download writes "standin <file name>" to its -o file; CruiseKube's API on
the port-forward answers as CruiseKube 0.3.4 does (pkg/server/server.go): health, preflight, settings, the workload
list, the overrides switch and the audit events (one recommendation applied). Calls are logged."""
import json, os, sys
args = sys.argv[1:]
open(os.environ["STANDIN_CALLS"], "a").write(json.dumps(["curl"] + args) + "\n")
url = next(a for a in args if a.startswith("http"))
if "-o" in args:      # a download: "standin <name>", and Kepler's DaemonSet with the image placeholder its README fills
    name = url.rsplit("/", 1)[-1]
    extra = "        image: <KEPLER_IMAGE>\n        imagePullPolicy: Always\n" if "kepler" in url and name == "daemonset.yaml" else ""
    open(args[args.index("-o") + 1], "w").write(f"standin {name}\n{extra}")
    sys.exit(0)
path = url.split("127.0.0.1:18080", 1)[-1]
wid = "Deployment:default:php-apache"
base = "/api/v1/clusters/default"
if path == "/health":
    print("ok")
elif path == base + "/workloads":
    print(json.dumps([{"workload_id": wid, "name": "php-apache", "namespace": "default", "kind": "Deployment",
                       "overrides": {"eviction_ranking": 2, "enabled": False}}]))
elif path == f"{base}/workloads/{wid}/overrides":
    print(json.dumps({"message": "Workload overrides updated successfully", "workload_id": wid, "overrides": {"enabled": True}}))
elif path.startswith(f"{base}/audit-events/{wid}"):
    print(json.dumps({"events": [{"cluster_id": "default", "type": "action", "category": "CPU_RECOMMENDATION_APPLIED"}]}))
elif path in (base + "/preflight", base + "/settings"):
    print(json.dumps({"ok": True}))
else:
    sys.exit(22)          # curl -f on a 404
