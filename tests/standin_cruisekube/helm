"""Stand-in helm for tests/test_cruisekube.py: pull writes a made-up chart archive; install succeeds. Calls are logged."""
import json, os, sys
args = sys.argv[1:]
open(os.environ["STANDIN_CALLS"], "a").write(json.dumps(["helm"] + args) + "\n")
if args and args[0] == "pull":
    d = args[args.index("--destination") + 1]
    v = args[args.index("--version") + 1]
    open(os.path.join(d, f"cruisekube-{v}.tgz"), "w").write("a made-up chart\n")
