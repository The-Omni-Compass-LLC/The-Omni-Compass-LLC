# Copy to .env and fill in. .env is never committed.
GRAFANA_ADMIN_PASSWORD=
OMNI_AUDIT_DIR=/var/log/omni
# the control panel the alert bridge presses (tools/omni_control.py serve), and whether it presses (1) or only writes (empty)
OMNI_PANEL_URL=http://host.docker.internal:9465
OMNI_BRIDGE_PRESS=
