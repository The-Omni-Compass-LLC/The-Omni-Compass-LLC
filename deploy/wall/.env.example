# Copy to .env (kept out of git) and set the password before docker compose up.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# where the governor writes its audit (omni_controller/controller.py --audit)
OMNI_AUDIT_DIR=/var/log/omni
PROMETHEUS_RETENTION=30d
# origins allowed to read this Prometheus from a browser (the live benchmark engine page); the default allows a page opened from a file
# or from this machine; set .* only on a machine nobody else browses from
# OMNI_PAGE_ORIGIN=
