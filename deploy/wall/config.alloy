// Grafana Alloy in Prometheus's collecting place (docker compose --profile alloy up -d): the same targets the wall's
// prometheus.yml names, collected every 5 s and written into the wall's Prometheus, so the Grafana wall reads them the same.
// Alloy collects and forwards telemetry; it writes no setting anywhere, and Omni-Compass's settings change only by the
// governor, its control panel and the kill switch.

// the governor's gauges from its audit (tools/omni_exporter.py)
prometheus.scrape "omni_exporter" {
  targets         = [{"__address__" = "omni-exporter:9464", "job" = "omni-exporter"}]
  scrape_interval = "5s"
  scrape_timeout  = "4s"
  forward_to      = [prometheus.remote_write.wall.receiver]
}

// this host's own counters (node_exporter in the same stack)
prometheus.scrape "node" {
  targets         = [{"__address__" = "node-exporter:9100", "job" = "node", "place" = "this host"}]
  scrape_interval = "5s"
  scrape_timeout  = "4s"
  forward_to      = [prometheus.remote_write.wall.receiver]
}

// your machines, services, Kepler and OpenCost: the same target files Prometheus reads
discovery.file "targets" {
  files = ["/etc/alloy/targets/nodes.yml", "/etc/alloy/targets/service.yml", "/etc/alloy/targets/kepler.yml", "/etc/alloy/targets/opencost.yml"]
}

prometheus.scrape "targets" {
  targets         = discovery.file.targets.targets
  scrape_interval = "5s"
  scrape_timeout  = "4s"
  forward_to      = [prometheus.remote_write.wall.receiver]
}

prometheus.remote_write "wall" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
